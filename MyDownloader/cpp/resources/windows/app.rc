// Windows Resource File for MyDownloader
// Icons and application manifest

#include <windows.h>

// Application Icon
// IDI_ICON1 ICON "app.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Urbantke Service Technics"
            VALUE "FileDescription", "MyDownloader - Ultimate Music & Video Downloader"
            VALUE "FileVersion", "3.0.0.0"
            VALUE "InternalName", "MyDownloader"
            VALUE "LegalCopyright", "Copyright (C) 2026 Urbantke Service Technics"
            VALUE "OriginalFilename", "MyDownloader.exe"
            VALUE "ProductName", "MyDownloader"
            VALUE "ProductVersion", "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application Manifest
1 RT_MANIFEST "app.manifest"
